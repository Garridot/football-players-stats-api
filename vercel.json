{
    "builds": [
      {
        "src": "project_package/wsgi.py",
        "use": "@vercel/python",
        "config": {"runtime": "python3.8.x"}
      },        
      {
        "src": "build.sh",
        "use": "@vercel/static-build",
        "config": {
          "distDir": "static"
        }
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "project_package/wsgi.py"
      }
    ]
  }